# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# Values for the first three: Supabase dashboard → Project Settings → API (API Keys).
#
# Leave all of them empty to run locally without Supabase ("dev mode": no login,
# cards saved to .data/cards.json). A production build refuses to run that way.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public key: the "anon" key (legacy) or the "publishable" key (sb_publishable_...).
# Used for login. Safe to expose — row-level security blocks it from the cards table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET key: the "service_role" key (legacy) or a "secret" key (sb_secret_...).
# Server-only; reads/writes the cards table. Never commit it or put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into the admin side, e.g. owner@example.com,office@example.com
# A Supabase user must be listed here AND have a confirmed email. Empty = nobody can log in.
ADMIN_EMAILS=

# Public base URL printed into every QR code — your real domain, no trailing slash,
# e.g. https://cards.example.com  (REQUIRED in production; cards can't be issued without it).
# Locally it may be left empty (falls back to http://localhost:3000).
# NEXT_PUBLIC_* values are baked in at build time: after changing it on Vercel, redeploy.
NEXT_PUBLIC_SITE_URL=
